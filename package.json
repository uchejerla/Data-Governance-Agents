{
  "name": "data-governance-agents",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent assistants that help data stewards deliver governance and stewardship work.",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "build:worker": "wrangler deploy --dry-run --outdir=worker-build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@freebuff/auth": "^0.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
